    <worksheet name='States with Negative EV Penetration Change between FY2022 and FY2024.'>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_date+ (Multiple Connections)' name='federated.1ontqpr1aq7ocp1ddhfux0z61nlm' />
          </datasources>
          <datasource-dependencies datasource='federated.1ontqpr1aq7ocp1ddhfux0z61nlm'>
            <column caption='fy2022' datatype='real' name='[Calculation_0550099169431553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [fiscal_year] = 2022&#13;&#10;THEN [electric_vehicles_sold]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [fiscal_year] = 2022&#13;&#10;THEN [total_vehicles_sold]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='fy2024' datatype='real' name='[Calculation_0550099170283522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [fiscal_year] = 2024&#13;&#10;THEN [electric_vehicles_sold]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [fiscal_year] = 2024&#13;&#10;THEN [total_vehicles_sold]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Penetration Change' datatype='real' name='[Calculation_0550099170406403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0550099170283522]-[Calculation_0550099169431553]' />
